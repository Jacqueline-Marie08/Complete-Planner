<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Student Planner</title>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: Arial, sans-serif;
    }

    body {
      background: #f7f8fc;
      color: #333;
    }

    header {
      background: #6c63ff;
      color: white;
      padding: 25px;
      text-align: center;
    }

    header h1 {
      font-size: 32px;
      margin-bottom: 8px;
    }

    header p {
      opacity: 0.9;
    }

    .container {
      max-width: 1100px;
      margin: 30px auto;
      padding: 0 20px;
    }

    .dashboard {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 20px;
      margin-bottom: 30px;
    }

    .card {
      background: white;
      border-radius: 15px;
      padding: 25px;
      box-shadow: 0 4px 15px rgba(0,0,0,0.08);
    }

    .card h2 {
      margin-bottom: 15px;
      color: #6c63ff;
    }

    .schedule {
      margin-bottom: 30px;
    }

    .class {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 15px;
      margin-bottom: 10px;
      background: #f1f0ff;
      border-radius: 10px;
    }

    .assignments {
      margin-bottom: 30px;
    }

    .assignment {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 15px;
      background: white;
      border-radius: 10px;
      margin-bottom: 10px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.05);
    }

    .assignment.completed {
      opacity: 0.55;
      text-decoration: line-through;
    }

    button {
      background: #6c63ff;
      color: white;
      border: none;
      padding: 10px 15px;
      border-radius: 8px;
      cursor: pointer;
      font-size: 14px;
    }

    button:hover {
      background: #574fd6;
    }

    input {
      width: 100%;
      padding: 12px;
      border: 1px solid #ddd;
      border-radius: 8px;
      margin-bottom: 10px;
    }

    .add-assignment {
      background: white;
      padding: 20px;
      border-radius: 15px;
      margin-bottom: 30px;
      box-shadow: 0 4px 15px rgba(0,0,0,0.08);
    }

    footer {
      text-align: center;
      padding: 25px;
      color: #777;
    }
  </style>
</head>

<body>

  <header>
    <h1>📚 My Student Planner</h1>
    <p>Stay organized. Stay on top of your classes.</p>
  </header>

  <div class="container">

    <div class="dashboard">

      <div class="card">
        <h2>📅 Today</h2>
        <p id="today"></p>
      </div>

      <div class="card">
        <h2>📝 Assignments</h2>
        <p><strong id="assignmentCount">0</strong> assignments</p>
      </div>

      <div class="card">
        <h2>🎯 Progress</h2>
        <p>Keep working toward your goals!</p>
      </div>

    </div>

    <div class="card schedule">
      <h2>🗓️ Today's Schedule</h2>

      <div class="class">
        <span>Business Law</span>
        <span>9:00 AM</span>
      </div>

      <div class="class">
        <span>Class 2</span>
        <span>10:00 AM</span>
      </div>

      <div class="class">
        <span>Class 3</span>
        <span>11:00 AM</span>
      </div>

    </div>

    <div class="add-assignment">
      <h2>➕ Add Assignment</h2>

      <input
        type="text"
        id="assignmentInput"
        placeholder="Assignment name"
      >

      <input
        type="text"
        id="classInput"
        placeholder="Class"
      >

      <button onclick="addAssignment()">Add Assignment</button>
    </div>

    <div class="assignments">
      <div class="card">
        <h2>📋 My Assignments</h2>

        <div id="assignmentList"></div>

      </div>
    </div>

  </div>

  <footer>
    Student Planner © 2026
  </footer>

  <script>

    // Show today's date
    const today = new Date();

    document.getElementById("today").textContent =
      today.toLocaleDateString(undefined, {
        weekday: "long",
        month: "long",
        day: "numeric",
        year: "numeric"
      });


    // Load assignments
    let assignments =
      JSON.parse(localStorage.getItem("assignments")) || [];


    function saveAssignments() {
      localStorage.setItem(
        "assignments",
        JSON.stringify(assignments)
      );
    }


    function displayAssignments() {

      const list =
        document.getElementById("assignmentList");

      list.innerHTML = "";

      document.getElementById("assignmentCount").textContent =
        assignments.length;


      assignments.forEach((assignment, index) => {

        const div = document.createElement("div");

        div.className = "assignment";

        if (assignment.completed) {
          div.classList.add("completed");
        }

        div.innerHTML = `
          <div>
            <strong>${assignment.name}</strong>
            <br>
            <small>${assignment.className}</small>
          </div>

          <button onclick="completeAssignment(${index})">
            ${assignment.completed ? "Undo" : "Complete"}
          </button>
        `;

        list.appendChild(div);

      });

    }


    function addAssignment() {

      const name =
        document.getElementById("assignmentInput").value.trim();

      const className =
        document.getElementById("classInput").value.trim();


      if (!name || !className) {
        alert("Please enter both an assignment and a class.");
        return;
      }


      assignments.push({
        name: name,
        className: className,
        completed: false
      });


      saveAssignments();

      displayAssignments();


      document.getElementById("assignmentInput").value = "";
      document.getElementById("classInput").value = "";

    }


    function completeAssignment(index) {

      assignments[index].completed =
        !assignments[index].completed;

      saveAssignments();

      displayAssignments();

    }


    displayAssignments();

  </script>

</body>
</html>
